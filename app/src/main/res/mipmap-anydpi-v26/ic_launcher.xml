<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon — Android 8.0+ (API 26+, which matches minSdk).
     The launcher clips this to the device's chosen icon shape
     (circle, squircle, rounded square, etc.) automatically.
     Background: solid green matching the app theme.
     Foreground: the full icon image (wizard on transparent bg).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
